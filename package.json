{
  "name": "markdown",
  "version": "3.0.0",
  "description": "A small utility to parse Markdown into sanitized HTML",
  "scripts": {
    "build": "vite build",
    "build:netlify": "vite build --outDir netlify && vite build --outDir netlify/markdown",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src e2e playwright.config.ts",
    "lint:fix": "eslint src e2e playwright.config.ts --fix",
    "coverage": "vitest run --coverage",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "keywords": [
    "markdown",
    "parse",
    "html"
  ],
  "author": "Craig McNaughton",
  "license": "ISC",
  "dependencies": {
    "marked": "^18.0.14",
    "sanitize-html": "^2.18.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/craigmcn/markdown.git"
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
